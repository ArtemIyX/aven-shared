{
  "name": "aven-workspace",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config playground/vite.config.ts --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build": "npm run build -w @wellsaik/aven-shared && npm run build -w @wellsaik/aven-vue",
    "build:playground": "vite build --config playground/vite.config.ts",
    "test": "node --test",
    "pack:check": "npm pack --dry-run -w @wellsaik/aven-shared && npm pack --dry-run -w @wellsaik/aven-vue",
    "colors:generate": "node scripts/generate-colors.mjs",
    "colors:check": "node scripts/generate-colors.mjs --check && node scripts/check-color-reference.mjs",
    "colors:browser": "node scripts/browser-colors.mjs",
    "colors:pack-browser": "node scripts/check-packed-colors.mjs",
    "pack:consumer": "node scripts/check-packed-consumer.mjs",
    "predev": "npm run build"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/server-renderer": "^3.5.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ]
}
