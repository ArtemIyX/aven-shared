{
  "name": "@wellsaik/aven-shared",
  "version": "0.1.1",
  "description": "Shared CSS tokens and Vue components for Aven applications",
  "keywords": [
    "vue",
    "vue3",
    "typescript",
    "design-system",
    "design-tokens",
    "css",
    "component-library"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArtemIyX/aven-shared.git"
  },
  "type": "module",
  "files": [
    "dist",
    "src/styles",
    "README.md",
    "LICENSE",
    "docs/color-palette.md",
    "docs/color-usage-guide.md",
    "docs/color-css-implementation-prompt.md",
    "docs/color-token-inventory.md",
    "src/tokens/colors.json"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./AvenText": {
      "types": "./dist/AvenText.d.ts",
      "import": "./dist/AvenText.js"
    },
    "./tokens.css": "./src/styles/tokens.css",
    "./base.css": "./src/styles/base.css",
    "./style.css": "./src/styles/style.css",
    "./colors.css": "./src/styles/colors.css",
    "./finance.css": "./src/styles/finance.css",
    "./charts.css": "./src/styles/charts.css",
    "./diagrams.css": "./src/styles/diagrams.css",
    "./gradients.css": "./src/styles/gradients.css"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build": "vite build && vue-tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:playground": "vite build --config playground/vite.config.ts",
    "test": "node --test",
    "pack:check": "npm pack --dry-run",
    "colors:generate": "node scripts/generate-colors.mjs",
    "colors:check": "node scripts/generate-colors.mjs --check && node scripts/check-color-reference.mjs",
    "colors:browser": "node scripts/browser-colors.mjs",
    "colors:pack-browser": "node scripts/check-packed-colors.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/server-renderer": "^3.5.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  }
}
