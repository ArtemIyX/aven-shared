{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "baseUrl": ".",
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "packages/vue/src/**/*.ts",
    "playground/src/**/*.ts",
    "playground/src/**/*.vue",
    "env.d.ts"
  ]
}
